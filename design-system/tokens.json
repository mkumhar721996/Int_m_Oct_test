    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Chips, inputs, small controls."
  },
  "radius-md": {
    "$type": "dimension",
    "$value": { "value": 6, "unit": "px" },
    "$description": "Buttons and medium controls."
  },
  "radius-lg": {
    "$type": "dimension",
    "$value": { "value": 10, "unit": "px" },
    "$description": "Cards and panels."
  },
  "border-width-sm": {
    "$type": "dimension",
    "$value": { "value": 1, "unit": "px" },
    "$description": "Default hairline border width."
  },
  "font-size-xs": {
    "$type": "dimension",
    "$value": { "value": 11, "unit": "px" },
    "$description": "Chip labels and table column headers."
  },
  "font-size-sm": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Secondary/helper text."
  },
  "font-size-md": {
    "$type": "dimension",
    "$value": { "value": 14, "unit": "px" },
    "$description": "Default body and control text for a data-dense console."
  },
  "font-size-lg": {
    "$type": "dimension",
    "$value": { "value": 18, "unit": "px" },
    "$description": "Card titles and section headings."
  },
  "font-size-xl": {
    "$type": "dimension",
    "$value": { "value": 22, "unit": "px" },
    "$description": "Page titles."
  },
  "font-family-base": {
    "$type": "fontFamily",
    "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "$description": "Default UI typeface."
  },
  "font-family-mono": {
    "$type": "fontFamily",
    "$value": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace",
    "$description": "IDs, timestamps, and log output."
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400,
    "$description": "Body text."
  },
  "font-weight-medium": {
    "$type": "fontWeight",
    "$value": 500,
    "$description": "Buttons, labels, table headers."
  },
  "font-weight-semibold": {
    "$type": "fontWeight",
    "$value": 600,
    "$description": "Card titles and page headings."
  },
  "line-height-tight": {
    "$type": "number",
    "$value": 1.3,
    "$description": "Headings."
  },
  "line-height-normal": {
    "$type": "number",
    "$value": 1.5,
    "$description": "Body copy."
  },
  "button-primary-background": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Primary button fill."
  },
  "button-primary-background-hover": {
    "$type": "color",
    "$value": "{color-primary-hover}",
    "$description": "Primary button fill on hover/active."
  },
  "button-primary-foreground": {
    "$type": "color",
    "$value": "{color-fg-inverse}",
    "$description": "Primary button label/icon color."
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$value": "{color-bg}",
    "$description": "Secondary (outline) button fill."
  },
  "button-secondary-foreground": {
    "$type": "color",
    "$value": "{color-primary}",
    "$description": "Secondary button label/icon color."
  },
  "button-secondary-border": {
    "$type": "color",
    "$value": "{color-border}",
    "$description": "Secondary button outline color."
  },
  "button-secondary-radius": {
    "$type": "dimension",
    "$value": "{radius-md}"
  },
  "card-default-background": {
    "$type": "color",
    "$value": "{color-bg}",
    "$description": "Card surface color."
  },
  "card-default-border": {
    "$type": "color",
    "$value": "{color-border}",
    "$description": "Card outline color."
  },
  "card-default-radius": {
    "$type": "dimension",
    "$value": "{radius-lg}"
  },
  "card-default-padding": {
    "$type": "dimension",
    "$value": "{space-4}"
  }
}
