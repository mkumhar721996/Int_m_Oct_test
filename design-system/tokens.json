{
  "color-fg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "hex": "#0f172a" },
    "$description": "Primary text color. Paired with color-bg, meets WCAG AA (4.5:1) for body text."
  },
  "color-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "Primary surface color: page content and card backgrounds."
  },
  "color-bg-subtle": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.945, 0.961, 0.976], "hex": "#f1f5f9" },
    "$description": "App shell background, used to set surfaces (cards, panels) apart from the canvas."
  },
  "color-fg-muted": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.278, 0.337, 0.412], "hex": "#475569" },
    "$description": "Secondary text: captions, timestamps, helper text."
  },
  "color-fg-inverse": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
    "$description": "Text/icon color for use on filled, colored surfaces such as the primary button."
  },
  "color-primary": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.114, 0.306, 0.847], "hex": "#1d4ed8" },
    "$description": "Primary action color for buttons, links, and focus accents."
  },
  "color-primary-hover": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.118, 0.251, 0.686], "hex": "#1e40af" },
    "$description": "Hover/active state for primary-colored controls."
  },
  "color-border": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.886, 0.91, 0.941], "hex": "#e2e8f0" },
    "$description": "Default hairline border for cards, inputs, and dividers."
  },
  "color-success": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.082, 0.502, 0.239], "hex": "#15803d" },
    "$description": "Text/icon color for successful or completed states."
  },
  "color-success-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.863, 0.988, 0.906], "hex": "#dcfce7" },
    "$description": "Background tint for success chips."
  },
  "color-warning": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.706, 0.325, 0.035], "hex": "#b45309" },
    "$description": "Text/icon color for at-risk or pending states."
  },
  "color-warning-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.996, 0.953, 0.78], "hex": "#fef3c7" },
    "$description": "Background tint for warning chips."
  },
  "color-danger": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.725, 0.11, 0.11], "hex": "#b91c1c" },
    "$description": "Text/icon color for failed or blocked states."
  },
  "color-danger-bg": {
    "$type": "color",
    "$value": { "colorSpace": "srgb", "components": [0.996, 0.886, 0.886], "hex": "#fee2e2" },
    "$description": "Background tint for danger chips."
  },
  "space-1": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Tightest spacing: icon-to-label gaps, chip internal padding."
  },
  "space-2": {
    "$type": "dimension",
    "$value": { "value": 8, "unit": "px" },
    "$description": "Compact spacing: form control padding, stacked list items."
  },
  "space-3": {
    "$type": "dimension",
    "$value": { "value": 12, "unit": "px" },
    "$description": "Default spacing: button padding, table cell padding."
  },
  "space-4": {
    "$type": "dimension",
    "$value": { "value": 16, "unit": "px" },
    "$description": "Card padding and gaps between related components."
  },
  "space-5": {
    "$type": "dimension",
    "$value": { "value": 24, "unit": "px" },
    "$description": "Gaps between distinct sections within a page."
  },
  "space-6": {
    "$type": "dimension",
    "$value": { "value": 32, "unit": "px" },
    "$description": "Page-level margins and major layout gutters."
  },
